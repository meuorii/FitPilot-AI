# Public URL of the existing Express API; use a LAN-reachable host for physical-device development.
# Replace both placeholders with the reachable Windows host and the port printed by Express.
# iPhone and BlueStacks on the same LAN usually use the host's private IPv4 address.
EXPO_PUBLIC_API_BASE_URL=http://<WINDOWS_LAN_IP>:<BACKEND_PORT>/api/v1
